{
  "name": "a1-prime-branch-management",
  "version": "1.0.0",
  "description": "PRU Life UK - A1 Prime Branch Management & Agent Performance System",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -n \"WEB,API\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "install:frontend": "npm install --workspace=frontend",
    "install:backend": "npm install --workspace=backend",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:create:local": "npm run db:create:local --workspace=backend",
    "db:reset:local": "npm run db:reset:local --workspace=backend",
    "db:setup:local": "npm run db:reset:local && npm run db:migrate:phase1 && npm run seed:a1prime --workspace=backend && npm run seed:admin --workspace=backend",
    "db:rollback": "npm run migrate:phase1:down --workspace=backend",
    "db:migrate:phase1": "npm run migrate:phase1:up --workspace=backend",
    "db:rebuild": "npm run db:rollback && npm run db:migrate:phase1",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "test:all": "npm run test --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend",
    "test:api": "npm run test:api --workspace=backend",
    "e2e": "npm run test:e2e --workspace=frontend"
  },
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm exec --workspace=frontend eslint -- --max-warnings=0 --fix"
    ],
    "backend/src/**/*.ts": [
      "npm exec --workspace=backend eslint -- --max-warnings=0 --fix"
    ],
    "**/*.{json,md,yml,yaml}": [
      "npx prettier --write"
    ]
  }
}
