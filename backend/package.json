{
  "name": "@a1prime/backend",
  "version": "0.1.0",
  "description": "PRU Life UK A1 Prime Branch Management — Fastify Backend",
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/app.ts",
    "dev:worker": "tsx watch --env-file=../.env src/jobs/worker.ts",
    "seed:admin": "ts-node-dev --transpile-only --exit-child src/scripts/seed-admin.ts",
    "migrate:phase1:up": "ts-node-dev --transpile-only --exit-child src/shared/db/migrations/runner.ts up",
    "migrate:phase1:down": "ts-node-dev --transpile-only --exit-child src/shared/db/migrations/runner.ts down",
    "migrate:validate": "tsx --env-file=../.env src/shared/db/migrations/validate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "jest --passWithNoTests",
    "test:unit": "vitest --configLoader native run src/services/__tests__",
    "test:api": "vitest --configLoader native run src/routes/__tests__"
  },
  "dependencies": {
    "@a1prime/schemas": "file:../packages/schemas",
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.73.5",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.8.4",
    "file-type": "^18.7.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "nanoid": "^3.3.11",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^6.4.23",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
