# A1 Prime - Environment Variable Reference
# Copy this file to .env in the project root and fill in the values.

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/a1prime_local
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/a1prime_local
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_SECONDS=20
DB_CONNECT_TIMEOUT_SECONDS=10
DB_USE_PGBOUNCER=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# Auth and Encryption
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Admin Seed
ADMIN_EMAIL=admin@a1prime.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET_NAME=a1prime-imports
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Document Repository Storage
DOCUMENT_STORAGE_PROVIDER=R2
DOCUMENT_STORAGE_SIGNED_URL_TTL_SECONDS=900

# Supabase Storage (optional future provider)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Malware Scan
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
