# ─── A1 Prime — Environment Variable Reference ───────────────────────────────
# Copy this file to .env in the project root and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/a1prime_local

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=           # Required in production
# REDIS_ENABLED=true        # Set to true in production to enable BullMQ queues

# ── Auth & Encryption ─────────────────────────────────────────────────────────
# Must be at least 32 characters. Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string-in-production

# 64-char hex string (openssl rand -hex 32) OR a passphrase (hashed to 32 bytes).
# Used to AES-256-GCM encrypt email addresses at rest.
# ROTATE THIS INDEPENDENTLY from JWT_SECRET.
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# JWT expiry for access tokens (default: 15m)
# JWT_EXPIRES_IN=15m

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Admin Seed (used by npm run seed:admin) ───────────────────────────────────
ADMIN_EMAIL=admin@a1prime.com
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# ── Cloudflare R2 (file storage) ─────────────────────────────────────────────
# Get these from the Cloudflare dashboard → R2 → Manage R2 API Tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET_NAME=a1prime-imports
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── Gmail OAuth2 (email queue) ────────────────────────────────────────────────
SMTP_USER=noreply@yourdomain.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Backend DSN (Node.js)
SENTRY_DSN=
# Frontend DSN (browser) — must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_SENTRY_DSN=
# Sentry org/project slugs (for source map upload in CI)
SENTRY_ORG=
SENTRY_PROJECT=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=info    # Options: fatal, error, warn, info, debug, trace
