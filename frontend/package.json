    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.47",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
