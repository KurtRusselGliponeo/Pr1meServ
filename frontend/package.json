{
  "name": "@a1prime/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('.next/static/development', { recursive: true })\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:lighthouse": "npm run build && concurrently --kill-others --success first \"npm --prefix ../backend run dev\" \"wait-on http-get://127.0.0.1:8080/health && lhci autorun\""
  },
  "dependencies": {
